# Same SQLite file as packages/database (path resolved from Prisma schema location)
# Required: all environments
DATABASE_URL="file:./dev.db"

# API server port (default 44101)
# Optional: local dev
PORT=44101

# development | test | production
NODE_ENV=development

# HMAC session signing — required in production; setup generates a dev value locally
SESSION_SECRET=

# Public web origin for links in API responses (email preview URLs)
APP_URL="http://localhost:44100"

# Allowed browser origin for CORS (web app URL)
# Required: staging/production must match HTTPS web origin
CORS_ORIGIN="http://localhost:44100"

# log = console adapter (local/CI). resend = Resend API (staging/prod, Phase 2)
EMAIL_PROVIDER=log

# Required when EMAIL_PROVIDER=resend
EMAIL_API_KEY=

# Required when EMAIL_PROVIDER=resend
EMAIL_FROM="PuraPuraLupa <noreply@example.com>"

# Staging sandbox: comma-separated allowlist (PS-39). Kosong = kirim ke semua (hati-hati).
# EMAIL_ALLOWLIST=qa@yourcompany.com

# Set 1 di belakang reverse proxy (rate limit / X-Forwarded-For)
# TRUST_PROXY=1
