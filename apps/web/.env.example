# Same SQLite file as packages/database (path resolved from Prisma schema location)
# Required: all environments
DATABASE_URL="file:./dev.db"

# Web server port (default 44100)
# Optional: local dev
PORT=44100

# development | test | production
# Required: production uses stricter session rules
NODE_ENV=development

# HMAC session signing — required in production; setup generates a dev value locally
SESSION_SECRET=

# Public app URL (invoice links in email). Dev default shown.
# Required: production
APP_URL="http://localhost:44100"

# Optional direct API calls from browser (v1 mostly uses web actions)
API_BASE_URL="http://localhost:44101"

# log = console adapter (local/CI). resend = Resend API (staging/prod, Phase 2)
# Optional: default log in dev
EMAIL_PROVIDER=log

# Required when EMAIL_PROVIDER=resend
EMAIL_API_KEY=

# Required when EMAIL_PROVIDER=resend
EMAIL_FROM="PuraPuraLupa <noreply@example.com>"

# Set 1 di belakang reverse proxy (HMR proxy / X-Forwarded-For)
# TRUST_PROXY=1
