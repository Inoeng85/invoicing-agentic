generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String          @map("password_hash")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  profile      BusinessProfile?
  clients      Client[]
  invoices     Invoice[]

  @@map("users")
}

model BusinessProfile {
  userId               String   @id @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName            String   @map("legal_name")
  address              String?
  npwp                 String?
  bankDetails          String?  @map("bank_details")
  footerDefault        String?  @map("footer_default")
  logoUrl              String?  @map("logo_url")
  invoiceNumberFormat  String   @default("INV-{YYYY}-{SEQ}") @map("invoice_number_format")
  defaultDueDays       Int      @default(30) @map("default_due_days")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("business_profiles")
}

model Client {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  address   String?
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  invoices  Invoice[]

  @@index([userId])
  @@map("clients")
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

model Invoice {
  id                   String            @id @default(cuid())
  userId               String            @map("user_id")
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId             String            @map("client_id")
  client               Client            @relation(fields: [clientId], references: [id])
  number               String?
  status               InvoiceStatus     @default(draft)
  issueDate            DateTime          @map("issue_date")
  dueDate              DateTime          @map("due_date")
  ppnEnabled           Boolean           @default(false) @map("ppn_enabled")
  ppnRate              Float             @default(0.11) @map("ppn_rate")
  subtotalCents        Int               @default(0) @map("subtotal_cents")
  ppnCents             Int               @default(0) @map("ppn_cents")
  totalCents           Int               @default(0) @map("total_cents")
  footerNote           String?           @map("footer_note")
  publicToken          String?           @unique @map("public_token")
  publicTokenRevokedAt DateTime?         @map("public_token_revoked_at")
  sentAt               DateTime?         @map("sent_at")
  paidAt               DateTime?         @map("paid_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  lineItems            InvoiceLineItem[]

  @@unique([userId, number])
  @@index([userId, status])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String  @map("invoice_id")
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder      Int     @map("sort_order")
  description    String
  quantity       Float
  unitPriceCents Int     @map("unit_price_cents")
  discountCents  Int     @default(0) @map("discount_cents")

  @@index([invoiceId])
  @@map("invoice_line_items")
}
