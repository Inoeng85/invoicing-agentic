# Path is relative to packages/database/prisma/schema.prisma → packages/database/prisma/dev.db
# Required: local, CI, staging, production
DATABASE_URL="file:./dev.db"

# Demo seed (local/staging only — Phase 2 PS-15)
# SEED_DEMO_USER_EMAIL=dewi.kartika@studio-kartika.demo
# SEED_DEMO_USER_PASSWORD=DemoStudio123!

# development | test | production — inherited from the app process; controls Prisma log level
# Optional: local dev
# NODE_ENV=development
