{
  "name": "@invoicing/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:seed:clients": "node --import tsx prisma/seed/run.ts clients",
    "db:seed:collectors": "node --import tsx prisma/seed/run.ts collectors",
    "db:seed:invoices": "node --import tsx prisma/seed/run.ts invoices",
    "db:seed:sample": "prisma migrate deploy && node --import tsx prisma/seed/run.ts all",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test prisma/seed/seed.test.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@invoicing/domain": "*",
    "@prisma/client": "^6.16.0"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "tsx": "^4.19.0"
  }
}
