{
  "name": "@invoicing/database",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:deploy:postgres": "prisma migrate deploy --schema=prisma/postgresql/schema.prisma",
    "db:generate:postgres": "prisma generate --schema=prisma/postgresql/schema.prisma",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && prisma generate --schema=prisma/postgresql/schema.prisma"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "tsx": "^4.19.0"
  }
}
