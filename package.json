{
  "name": "invoicing-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/assert-node.mjs",
    "dev": "concurrently -k -n web,api -c green,blue \"npm run dev -w @invoicing/web\" \"npm run dev -w @invoicing/api\"",
    "dev:web": "node scripts/assert-node.mjs && npm run dev -w @invoicing/web",
    "dev:api": "node scripts/assert-node.mjs && npm run dev -w @invoicing/api",
    "start": "concurrently -k -n web,api \"npm run start:web\" \"npm run start:api\"",
    "start:web": "npm run start -w @invoicing/web",
    "start:api": "npm run start -w @invoicing/api",
    "host:check": "node --import tsx scripts/host-env-check.ts",
    "test": "npm run test -w @invoicing/web",
    "typecheck": "npm run typecheck -w @invoicing/web && npm run typecheck -w @invoicing/api && npm run typecheck -w @invoicing/domain && npm run typecheck -w @invoicing/platform",
    "doctor": "node --import tsx scripts/doctor.ts",
    "release:check": "node --import tsx scripts/release-readiness.ts",
    "staging:smoke": "node --import tsx scripts/staging-smoke.ts",
    "ci:local": "node --import tsx scripts/ci-local.ts",
    "email:smoke": "node --import tsx scripts/email-smoke.ts",
    "test:domain": "npm run test -w @invoicing/domain",
    "test:seed": "npm run test -w @invoicing/database",
    "gate": "node --import tsx scripts/gates/run-all.ts",
    "css:build": "npm run css:build -w @invoicing/web",
    "design:css": "tailwindcss -i docs/design/prototype/src/tailwind.css -o docs/design/prototype/assets/ui.css --minify",
    "design:css:watch": "tailwindcss -i docs/design/prototype/src/tailwind.css -o docs/design/prototype/assets/ui.css --watch",
    "design:serve": "npm run design:css && serve docs/design/prototype -l 8765",
    "db:migrate": "npm run db:migrate -w @invoicing/database",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @invoicing/database",
    "db:reset": "npm run db:reset -w @invoicing/database",
    "db:seed": "npm run db:seed -w @invoicing/database",
    "db:seed:clients": "npm run db:seed:clients -w @invoicing/database",
    "db:seed:collectors": "npm run db:seed:collectors -w @invoicing/database",
    "db:seed:invoices": "npm run db:seed:invoices -w @invoicing/database",
    "db:seed:sample": "node scripts/assert-agentic-root.mjs && npm run db:seed:sample -w @invoicing/database",
    "db:studio": "npm run db:studio -w @invoicing/database",
    "setup": "node --import tsx scripts/setup.ts",
    "verify": "node --import tsx scripts/verify.ts",
    "agentic:catalog": "node scripts/assert-agentic-root.mjs && node scripts/agentic/build-catalog.mjs",
    "agentic:intake-queue": "node scripts/assert-agentic-root.mjs && node scripts/agentic/build-intake-queue.mjs --all",
    "agentic:intake-queue:refresh": "node scripts/assert-agentic-root.mjs && node scripts/agentic/build-intake-queue.mjs --catalog --all",
    "agentic:kanban-data": "node scripts/assert-agentic-root.mjs && node scripts/agentic/build-intake-queue.mjs --all --merge && node scripts/agentic/build-kanban-board-data.mjs",
    "agentic:kanban-watch": "node scripts/assert-agentic-root.mjs && node scripts/agentic/watch-kanban-data.mjs",
    "agentic:validate-dev": "node scripts/assert-agentic-root.mjs && node scripts/agentic/validate-development-task.mjs",
    "agentic:validate-qa": "node scripts/assert-agentic-root.mjs && node scripts/agentic/validate-qa-task.mjs",
    "agentic:validate-audit": "node scripts/assert-agentic-root.mjs && node scripts/agentic/validate-audit-phase.mjs",
    "agentic:intake-run": "node scripts/assert-agentic-root.mjs && node scripts/agentic/run-intake-pipeline.mjs",
    "agentic:validate-plan": "node scripts/assert-agentic-root.mjs && node scripts/agentic/validate-plan-task.mjs",
    "agentic:show-report": "node scripts/assert-agentic-root.mjs && node scripts/agentic/show-task-report.mjs",
    "agentic:plan-path": "node scripts/assert-agentic-root.mjs && node scripts/agentic/plan-path.mjs",
    "agentic:serve-kanban": "node scripts/assert-agentic-root.mjs && npx --yes serve -p 3456",
    "agentic:trigger-next": "node scripts/assert-agentic-root.mjs && node scripts/agentic/trigger-next.mjs",
    "agentic:bootstrap-plans": "node scripts/assert-agentic-root.mjs && node scripts/agentic/bootstrap-task-plans.mjs",
    "agentic:autopilot": "node scripts/assert-agentic-root.mjs && node scripts/agentic/run-autopilot.mjs",
    "agentic:autopilot:watch": "node scripts/assert-agentic-root.mjs && node scripts/agentic/run-autopilot.mjs watch",
    "agentic:daemon": "node scripts/assert-agentic-root.mjs && node scripts/agentic/run-orchestration-daemon.mjs",
    "agentic:task-checklist": "node scripts/assert-agentic-root.mjs && node scripts/agentic/build-task-checklist.mjs",
    "agentic:monitoring-data": "node scripts/assert-agentic-root.mjs && node scripts/agentic/build-monitoring-data.mjs"
  },
  "devDependencies": {
    "@invoicing/platform": "*",
    "concurrently": "^9.2.0",
    "serve": "^14.2.4",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
